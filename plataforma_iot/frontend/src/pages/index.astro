        function updateSensorDiagnostics(t1, t2, hum) {
            if (t1 !== null && t1 !== undefined) {
                if (t1 > -50 && t1 < 100) s1History.push(t1);
                document.getElementById('diag-s1-temp').innerHTML = `${t1.toFixed(1)}<span class="text-xl text-slate-500 font-normal">°C</span>`;
                
                const pct1 = Math.max(0, Math.min(100, ((t1 - 15) / 25) * 100));
                document.getElementById('diag-s1-ring').style.strokeDashoffset = 251.2 - (pct1 / 100) * 251.2;

                const badge1 = document.getElementById('diag-s1-status');
                if (t1 <= -120) {
                    badge1.className = "px-3 py-1 rounded-full text-xs font-mono font-bold bg-rose-950 text-rose-300 border border-rose-700 animate-pulse";
                    badge1.textContent = "⚠️ ERROR -127°C: Bus Desconectado";
                } else if (Math.abs(t1 - 85.0) < 0.2) {
                    badge1.className = "px-3 py-1 rounded-full text-xs font-mono font-bold bg-amber-950 text-amber-300 border border-amber-700 animate-pulse";
                    badge1.textContent = "⚠️ AVISO 85°C: Fallo de Conversión";
                } else {
                    badge1.className = "px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-950 text-emerald-300 border border-emerald-700";
                    badge1.textContent = "🟢 Operativo (Lectura Válida)";
                }

                if (s1History.length > 0) {
                    const min1 = Math.min(...s1History);
                    const max1 = Math.max(...s1History);
                    const avg1 = s1History.reduce((a, b) => a + b, 0) / s1History.length;
                    document.getElementById('diag-s1-min').textContent = `${min1.toFixed(1)}°C`;
                    document.getElementById('diag-s1-max').textContent = `${max1.toFixed(1)}°C`;
                    document.getElementById('diag-s1-avg').textContent = `${avg1.toFixed(1)}°C`;
                }
            }

            if (t2 !== null && t2 !== undefined) {
                if (t2 > -50 && t2 < 100) s2History.push(t2);
                document.getElementById('diag-s2-temp').innerHTML = `${t2.toFixed(1)}<span class="text-xl text-slate-500 font-normal">°C</span>`;
                
                const pct2 = Math.max(0, Math.min(100, ((t2 - 15) / 25) * 100));
                document.getElementById('diag-s2-ring').style.strokeDashoffset = 251.2 - (pct2 / 100) * 251.2;

                const badge2 = document.getElementById('diag-s2-status');
                if (t2 <= -120) {
                    badge2.className = "px-3 py-1 rounded-full text-xs font-mono font-bold bg-rose-950 text-rose-300 border border-rose-700 animate-pulse";
                    badge2.textContent = "⚠️ ERROR: DHT22 Desconectado";
                } else {
                    badge2.className = "px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-950 text-emerald-300 border border-emerald-700";
                    badge2.textContent = "🟢 DHT22 Operativo";
                }

                const humEl = document.getElementById('diag-s2-hum');
                if (humEl && hum !== null && hum !== undefined && hum > 0) {
                    humEl.textContent = `Hum: ${hum.toFixed(1)}%`;
                }
                const humPill = document.getElementById('val-humidity-pill');
                if (humPill && hum !== null && hum !== undefined && hum > 0) {
                    humPill.textContent = `Hum: ${hum.toFixed(1)}%`;
                }

                if (s2History.length > 0) {
                    const min2 = Math.min(...s2History);
                    const max2 = Math.max(...s2History);
                    const avg2 = s2History.reduce((a, b) => a + b, 0) / s2History.length;
                    document.getElementById('diag-s2-min').textContent = `${min2.toFixed(1)}°C`;
                    document.getElementById('diag-s2-max').textContent = `${max2.toFixed(1)}°C`;
                    document.getElementById('diag-s2-avg').textContent = `${avg2.toFixed(1)}°C`;
                }
            }

            // Cruce Térmico
            if (t1 !== null && t2 !== null && t1 > -50 && t2 > -50) {
                const delta = Math.abs(t1 - t2);
                document.getElementById('diag-delta-temp').innerHTML = `${delta.toFixed(2)}<span class="text-sm text-slate-500 font-normal">°C</span>`;
                const crossBadge = document.getElementById('diag-cross-status');
                if (delta <= 0.6) {
                    crossBadge.className = "px-4 py-2 rounded-2xl text-xs font-mono font-bold bg-emerald-950 text-emerald-300 border border-emerald-700";
                    crossBadge.textContent = "Calibración Óptima (Offset <= 0.6°C)";
                } else if (delta <= 1.5) {
                    crossBadge.className = "px-4 py-2 rounded-2xl text-xs font-mono font-bold bg-amber-950 text-amber-300 border border-amber-700";
                    crossBadge.textContent = "Offset Aceptable en Reposo";
                } else {
                    crossBadge.className = "px-4 py-2 rounded-2xl text-xs font-mono font-bold bg-purple-950 text-purple-300 border border-purple-700";
                    crossBadge.textContent = "Gradiente Térmico Activo";
                }
            }
        }

