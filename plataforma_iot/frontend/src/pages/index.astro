        function updateEditorCounters() {
            const code = editorEl.value;
            const lines = code.split('\n').length;
            const chars = code.length;
            document.getElementById('ide-line-count').textContent = `Líneas: ${lines}`;
            document.getElementById('ide-char-count').textContent = `Caracteres: ${chars}`;
        }

        editorEl.addEventListener('input', updateEditorCounters);

        editorEl.addEventListener('keydown', function(e) {
            if (e.key === 'Tab') {
                e.preventDefault();
                const start = this.selectionStart;
                const end = this.selectionEnd;
                this.value = this.value.substring(0, start) + "  " + this.value.substring(end);
                this.selectionStart = this.selectionEnd = start + 2;
                updateEditorCounters();
            }
        });

        async function loadIDETemplates() {
            try {
                const res = await fetch(`${API}/api/ide/templates`);
                const data = await res.json();
                if (data.status === 'success') {
                    ideTemplates = {};
                    templateSelectEl.innerHTML = '';
                    data.templates.forEach(tpl => {
                        ideTemplates[tpl.id] = tpl;
                        const opt = document.createElement('option');
                        opt.value = tpl.id;
                        opt.textContent = `${tpl.title}`;
                        templateSelectEl.appendChild(opt);
                    });
                    if (data.templates.length > 0) {
                        loadTemplateIntoEditor(data.templates[0].id);
                    }
                }
            } catch(e) {
                console.error("Error cargando plantillas IDE:", e);
            }
        }

        function loadTemplateIntoEditor(tplId) {
            const tpl = ideTemplates[tplId];
            if (tpl) {
                editorEl.value = tpl.code;
                document.getElementById('ide-filename').textContent = tpl.id === 'test_sensores' ? 'test_sensores.ino' : (tpl.id === 'step_response' ? 'step_response.ino' : 'esp32_firmware.ino');
                document.getElementById('ide-file-status').textContent = `Plantilla cargada: ${tpl.badge}`;
                updateEditorCounters();
            }
        }

        templateSelectEl.addEventListener('change', (e) => {
            loadTemplateIntoEditor(e.target.value);
        });

        async function refreshIDEPorts() {
            try {
                const res = await fetch(`${API}/ports`);
                const ports = await res.json();
                portSelectEl.innerHTML = '';
                if (ports.length === 0) {
                    const opt = document.createElement('option');
                    opt.value = '';
                    opt.textContent = 'Sin puertos detectados';
                    portSelectEl.appendChild(opt);
                } else {
                    ports.forEach(p => {
                        const opt = document.createElement('option');
                        opt.value = p;
                        opt.textContent = p;
                        portSelectEl.appendChild(opt);
                    });
                }
            } catch(e) {}
        }

        document.getElementById('btn-refresh-ports').addEventListener('click', () => {
            refreshIDEPorts();
            showToast("Puertos", "Lista de puertos serie actualizada", "🔄");
        });

        // Botón COMPILAR
        document.getElementById('btn-ide-compile').addEventListener('click', async () => {
            const code = editorEl.value;
            if (!code.trim()) return showToast("Aviso", "El editor está vacío.", "⚠️");

            document.getElementById('spin-compile').classList.remove('hidden');
            document.getElementById('icon-compile').classList.add('hidden');
            terminalStatusEl.textContent = "Compilando con arduino-cli...";
            terminalStatusEl.className = "text-[11px] font-mono text-cyan-300 animate-pulse";
            terminalEl.textContent = `[ALUNA IDE]: Iniciando compilación para ESP32...\n$ arduino-cli compile --fqbn esp32:esp32:esp32 build_cache.ino\nEspere un momento...`;

            try {
                const res = await fetch(`${API}/api/ide/compile`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code: code, fqbn: 'esp32:esp32:esp32' })
                });
                const data = await res.json();

                if (res.ok && data.status === 'success') {
                    terminalStatusEl.textContent = "Compilación Exitosa (0 Errores)";
                    terminalStatusEl.className = "text-[11px] font-mono text-emerald-400 font-bold";
                    terminalEl.textContent = `[ALUNA IDE] COMPILACIÓN EXITOSA:\n--------------------------------------------------\n${data.message}\n--------------------------------------------------\n¡El binario está listo para ser cargado en el ESP32!`;
                    showToast("Compilación Exitosa", "Firmware verificado sin errores.", "✅");
                } else {
                    terminalStatusEl.textContent = "Error de Compilación";
                    terminalStatusEl.className = "text-[11px] font-mono text-rose-400 font-bold";
                    terminalEl.textContent = `[ALUNA IDE] ERROR DE COMPILACIÓN:\n--------------------------------------------------\n${data.message}\n--------------------------------------------------`;
                    showToast("Error de Sintaxis", "Revisa el log de la terminal.", "❌");
                }
            } catch(e) {
                terminalStatusEl.textContent = "Error de Conexión";
                terminalEl.textContent = `[ALUNA IDE] Error comunicando con el backend: ${e.message}`;
            } finally {
                document.getElementById('spin-compile').classList.add('hidden');
                document.getElementById('icon-compile').classList.remove('hidden');
            }
        });

        // Botón CARGAR AL ESP32
        document.getElementById('btn-ide-upload').addEventListener('click', async () => {
            const code = editorEl.value;
            const port = portSelectEl.value;
            if (!code.trim()) return showToast("Aviso", "El editor está vacío.", "⚠️");

            document.getElementById('spin-upload').classList.remove('hidden');
            document.getElementById('icon-upload').classList.add('hidden');
            terminalStatusEl.textContent = "Flasheando microcontrolador...";
            terminalStatusEl.className = "text-[11px] font-mono text-amber-300 animate-pulse";
            terminalEl.textContent = `[ALUNA IDE]: Preparando flasheo USB...\nLiberando puerto serial...\n$ arduino-cli compile --upload -p ${port} --fqbn esp32:esp32:esp32 build_cache.ino\nTransmitiendo bloques esptool...`;

            try {
                const res = await fetch(`${API}/api/ide/upload`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ code: code, port: port, fqbn: 'esp32:esp32:esp32' })
                });
                const data = await res.json();

                if (res.ok && data.status === 'success') {
                    terminalStatusEl.textContent = "Carga Exitosa (100%)";
                    terminalStatusEl.className = "text-[11px] font-mono text-emerald-400 font-bold";
                    terminalEl.textContent = `[ALUNA IDE] CARGA FINALIZADA CON ÉXITO:\n--------------------------------------------------\n${data.message}\n--------------------------------------------------\n¡ESP32 reiniciado y ejecutando nuevo firmware! Telemetría reanudada.`;
                    showToast("Carga Exitosa", "Firmware transferido al ESP32.", "⚡");
                } else {
                    terminalStatusEl.textContent = "Fallo al Flashear";
                    terminalStatusEl.className = "text-[11px] font-mono text-rose-400 font-bold";
                    terminalEl.textContent = `[ALUNA IDE] ERROR AL FLASHEAR:\n--------------------------------------------------\n${data.message}\n--------------------------------------------------\nSugerencia: Si el ESP32 no responde, mantén presionado el botón BOOT durante el inicio de la carga.`;
                    showToast("Fallo al Cargar", "Verifica el puerto o mantén presionado BOOT.", "❌");
                }
            } catch(e) {
                terminalStatusEl.textContent = "Error de Conexión";
                terminalEl.textContent = `[ALUNA IDE] Error comunicando con el backend: ${e.message}`;
            } finally {
                document.getElementById('spin-upload').classList.add('hidden');
                document.getElementById('icon-upload').classList.remove('hidden');
            }
        });

        // Copiar, Resetear, Limpiar
        document.getElementById('btn-copy-code').addEventListener('click', () => {
            navigator.clipboard.writeText(editorEl.value);
            showToast("Copiado", "Código copiado al portapapeles", "📋");
        });
        document.getElementById('btn-reset-code').addEventListener('click', () => {
            loadTemplateIntoEditor(templateSelectEl.value);
            showToast("Restaurado", "Plantilla original restaurada", "🔄");
        });
        document.getElementById('btn-clear-code').addEventListener('click', () => {
            editorEl.value = "";
            updateEditorCounters();
            showToast("Limpio", "Editor vaciado", "🗑️");
        });
        document.getElementById('btn-clear-terminal').addEventListener('click', () => {
            terminalEl.textContent = "[ALUNA IDE]: Terminal en espera.";
            terminalStatusEl.textContent = "Listo";
            terminalStatusEl.className = "text-[11px] font-mono text-slate-400";
        });

        // INICIALIZACIÓN DEL SISTEMA
        loadIDETemplates();
        refreshIDEPorts();
        autoDetectAndConnect();
        autoScanInterval = setInterval(autoDetectAndConnect, 2000);
    </script>
</body>
</html>
