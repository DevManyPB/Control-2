<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ALUNA PBR-02 | Bio-Thermal Control Deck</title>
    
    <!-- Frameworks Visuales de Élite: Tailwind CSS + Apache ECharts -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
    
    <!-- Tipografías de Grado Profesional -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    
    <script is:inline>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Space Grotesk', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        deep: '#030712',
                        surface: '#090e1a',
                        neonTeal: '#00f2fe',
                        neonEmerald: '#10b981',
                        neonPurple: '#b026ff',
                        neonAmber: '#f59e0b',
                    }
                }
            }
        }
    </script>
    
    <style>
        :root { color-scheme: dark; }
        body {
            background-color: #02040a;
            background-image: 
                radial-gradient(at 0% 0%, rgba(0, 242, 254, 0.06) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(176, 38, 255, 0.06) 0px, transparent 50%),
                radial-gradient(at 50% 100%, rgba(16, 185, 129, 0.05) 0px, transparent 60%),
                linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 100% 100%, 40px 40px, 40px 40px;
        }
        
        .hud-card {
            background: linear-gradient(135deg, rgba(13, 20, 36, 0.8) 0%, rgba(6, 10, 20, 0.9) 100%);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        }
        
        .hud-card-interactive {
            transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .hud-card-interactive:hover {
            border-color: rgba(0, 242, 254, 0.3);
            box-shadow: 0 20px 40px -15px rgba(0, 242, 254, 0.15);
        }

        .glow-teal { box-shadow: 0 0 30px -5px rgba(0, 242, 254, 0.35); }
        .glow-emerald { box-shadow: 0 0 30px -5px rgba(16, 185, 129, 0.35); }
        .glow-purple { box-shadow: 0 0 30px -5px rgba(176, 38, 255, 0.35); }

        /* Sliders de Precisión */
        input[type=range] {
            -webkit-appearance: none;
            background: #111827;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 9999px;
            height: 8px;
            outline: none;
        }
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 22px;
            width: 22px;
            border-radius: 50%;
            background: #ffffff;
            cursor: pointer;
            box-shadow: 0 0 16px #00f2fe;
            border: 3px solid #00f2fe;
            transition: all 0.2s ease;
        }
        input[type=range]::-webkit-slider-thumb:hover {
            transform: scale(1.2);
            box-shadow: 0 0 24px #00f2fe;
        }

        /* Micro-animación de burbujas en el tanque de microalgas */
        @keyframes floatBubble {
            0% { transform: translateY(0) translateX(0); opacity: 0; }
            20% { opacity: 0.8; }
            80% { opacity: 0.8; }
            100% { transform: translateY(-70px) translateX(6px); opacity: 0; }
        }
        .bubble-1 { animation: floatBubble 2.5s infinite ease-in; }
        .bubble-2 { animation: floatBubble 3.2s infinite ease-in 0.9s; }
        .bubble-3 { animation: floatBubble 2.1s infinite ease-in 1.5s; }

        /* Anillos Radiales SVG */
        .gauge-circle {
            transition: stroke-dashoffset 0.8s cubic-bezier(0.16, 1, 0.3, 1);
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
        }

        /* Modal backdrop blur */
        .modal-backdrop {
            background-color: rgba(2, 4, 10, 0.8);
            backdrop-filter: blur(12px);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-teal-500 selection:text-black">
    
    <!-- TOAST FLOTANTE DE NOTIFICACIONES -->
    <div id="toast" class="fixed top-6 right-6 z-50 transform -translate-y-20 opacity-0 pointer-events-none transition-all duration-300">
        <div class="hud-card border border-teal-400/40 px-5 py-3 rounded-2xl shadow-2xl flex items-center gap-3.5 bg-slate-950/95">
            <span id="toast-icon" class="text-2xl">⚡</span>
            <div>
                <p id="toast-title" class="text-xs font-bold font-mono uppercase text-white tracking-widest">Sistema</p>
                <p id="toast-msg" class="text-xs text-slate-300">Mensaje</p>
            </div>
        </div>
    </div>

    <!-- ================================================================= -->
    <!-- BARRA SUPERIOR: CENTRO DE TELEMETRÍA Y AUTOCONEXIÓN -->
    <!-- ================================================================= -->
    <header class="hud-card border-b border-white/10 px-8 py-4 sticky top-0 z-40">
        <div class="max-w-[1600px] mx-auto flex flex-wrap justify-between items-center gap-6">
            
            <!-- Marca y Especie -->
            <div class="flex items-center gap-4">
                <div class="relative w-12 h-12 rounded-2xl bg-gradient-to-tr from-teal-500/20 via-emerald-500/10 to-transparent border border-teal-400/30 flex items-center justify-center glow-teal">
                    <span class="text-2xl">🧬</span>
                    <div class="absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full bg-emerald-500 border-2 border-slate-950 flex items-center justify-center">
                        <div class="w-1.5 h-1.5 rounded-full bg-white animate-ping"></div>
                    </div>
                </div>
                <div>
                    <div class="flex items-center gap-2.5">
                        <h1 class="text-xl font-bold tracking-tight text-white font-sans">ALUNA <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-400 to-cyan-300 font-extrabold">PBR-02</span></h1>
                        <span class="px-2.5 py-0.5 text-[10px] font-mono font-bold bg-teal-500/10 text-teal-300 border border-teal-500/30 rounded-full">Tetraselmis chuii</span>
                        <span class="px-2.5 py-0.5 text-[10px] font-mono font-bold bg-purple-500/10 text-purple-300 border border-purple-500/30 rounded-full">Frailejón V2</span>
                    </div>
                    <p class="text-xs text-slate-400 font-medium">Biorreactor Térmico Cuántico &middot; Universidad del Magdalena</p>
                </div>
            </div>

            <!-- Acciones de Cabecera: Guía de Uso + Conexión Inteligente -->
            <div class="flex items-center gap-3">
                
                <!-- Botón de Guía de Uso -->
                <button id="btn-open-guide" class="px-4 py-2 bg-slate-900/90 hover:bg-slate-800 text-teal-300 border border-teal-500/30 hover:border-teal-400 text-xs font-mono font-bold rounded-xl transition flex items-center gap-2 shadow-lg">
                    <span>📖</span> GUÍA DE OPERACIÓN
                </button>

                <!-- Terminal de Conexión Automática -->
                <div class="flex items-center gap-2.5 bg-black/60 p-1.5 rounded-2xl border border-white/10 shadow-inner">
                    <div class="flex items-center gap-2 px-3 py-1.5 bg-slate-900/90 rounded-xl border border-white/5">
                        <span id="conn-dot" class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-[0_0_10px_#f59e0b] animate-pulse"></span>
                        <span id="conn-text" class="text-xs font-mono font-semibold text-slate-300">BUSCANDO ESP32...</span>
                    </div>

                    <!-- Botón de Desconexión / Reconexión Dinámico -->
                    <button id="btn-toggle-conn" class="hidden px-4 py-1.5 bg-rose-600/90 hover:bg-rose-500 text-white text-xs font-mono font-extrabold rounded-xl shadow-lg transition tracking-wide">
                        DESCONECTAR
                    </button>
                    
                    <button id="btn-manual-reconnect" class="hidden px-4 py-1.5 bg-gradient-to-r from-teal-500 to-emerald-500 hover:from-teal-400 text-slate-950 text-xs font-mono font-extrabold rounded-xl shadow-lg transition tracking-wide">
                        RECONECTAR
                    </button>
                </div>

            </div>

        </div>
    </header>

    <!-- ================================================================= -->
    <!-- CUERPO PRINCIPAL DEL TABLERO -->
    <!-- ================================================================= -->
    <main class="max-w-[1600px] mx-auto px-8 py-8 space-y-8 flex-1 w-full">

        <!-- FILA SUPERIOR: 4 GAUGES RADIALES HUD -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            
            <!-- Gauge 1: Temperatura del Reactor -->
            <div class="hud-card hud-card-interactive p-6 rounded-3xl relative overflow-hidden flex items-center justify-between">
                <div>
                    <span class="text-xs font-mono uppercase tracking-widest text-slate-400 font-semibold">T. Reactor (Agua)</span>
                    <div id="val-t1" class="text-4xl font-extrabold text-teal-300 font-mono mt-2 tracking-tight">--.-<span class="text-lg text-slate-500 font-normal">°C</span></div>
                    <div class="mt-2 flex items-center gap-2">
                        <span id="badge-optimo" class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-slate-800 text-slate-400">Buscando Sensor</span>
                        <span class="text-[11px] text-slate-400 font-mono">Meta: 21.0°C</span>
                    </div>
                </div>
                <div class="relative w-20 h-20 flex items-center justify-center">
                    <svg class="w-20 h-20" viewBox="0 0 100 100">
                        <circle cx="50" cy="50" r="40" stroke="#1e293b" stroke-width="8" fill="transparent"/>
                        <circle id="gauge-t1-ring" class="gauge-circle" cx="50" cy="50" r="40" stroke="#00f2fe" stroke-width="8" fill="transparent" stroke-dasharray="251.2" stroke-dashoffset="251.2" stroke-linecap="round"/>
                    </svg>
                    <span class="absolute text-xs font-mono font-bold text-teal-400">D15</span>
                </div>
            </div>

            <!-- Gauge 2: Temperatura del Disipador / Ambiente -->
            <div class="hud-card hud-card-interactive p-6 rounded-3xl relative overflow-hidden flex items-center justify-between">
                <div>
                    <span class="text-xs font-mono uppercase tracking-widest text-slate-400 font-semibold">T. Ambiente / Ext</span>
                    <div id="val-t2" class="text-4xl font-extrabold text-emerald-300 font-mono mt-2 tracking-tight">--.-<span class="text-lg text-slate-500 font-normal">°C</span></div>
                    <div class="mt-2 flex items-center gap-2">
                        <span class="text-[11px] text-slate-400 font-mono">Disipador Caliente</span>
                    </div>
                </div>
                <div class="relative w-20 h-20 flex items-center justify-center">
                    <svg class="w-20 h-20" viewBox="0 0 100 100">
                        <circle cx="50" cy="50" r="40" stroke="#1e293b" stroke-width="8" fill="transparent"/>
                        <circle id="gauge-t2-ring" class="gauge-circle" cx="50" cy="50" r="40" stroke="#10b981" stroke-width="8" fill="transparent" stroke-dasharray="251.2" stroke-dashoffset="251.2" stroke-linecap="round"/>
                    </svg>
                    <span class="absolute text-xs font-mono font-bold text-emerald-400">D13</span>
                </div>
            </div>

            <!-- Gauge 3: Esfuerzo de Potencia Peltier -->
            <div class="hud-card hud-card-interactive p-6 rounded-3xl relative overflow-hidden flex items-center justify-between">
                <div>
                    <span class="text-xs font-mono uppercase tracking-widest text-slate-400 font-semibold">Peltier TEC1</span>
                    <div id="val-pwm-num" class="text-4xl font-extrabold text-cyan-300 font-mono mt-2 tracking-tight">0<span class="text-lg text-slate-500 font-normal">/255</span></div>
                    <div class="mt-2 flex items-center gap-2">
                        <span id="val-watts" class="text-[11px] text-cyan-400 font-mono font-bold">0 W</span>
                        <span class="text-slate-600">&bull;</span>
                        <span id="val-amps" class="text-[11px] text-slate-400 font-mono">0.0 A</span>
                    </div>
                </div>
                <div class="relative w-20 h-20 flex items-center justify-center">
                    <svg class="w-20 h-20" viewBox="0 0 100 100">
                        <circle cx="50" cy="50" r="40" stroke="#1e293b" stroke-width="8" fill="transparent"/>
                        <circle id="gauge-pwm-ring" class="gauge-circle" cx="50" cy="50" r="40" stroke="#06b6d4" stroke-width="8" fill="transparent" stroke-dasharray="251.2" stroke-dashoffset="251.2" stroke-linecap="round"/>
                    </svg>
                    <span id="val-pwm-pct" class="absolute text-xs font-mono font-bold text-cyan-300">0%</span>
                </div>
            </div>

            <!-- Gauge 4: Escudo Frailejón (Servo MG996R) -->
            <div class="hud-card hud-card-interactive p-6 rounded-3xl relative overflow-hidden flex items-center justify-between">
                <div>
                    <span class="text-xs font-mono uppercase tracking-widest text-slate-400 font-semibold">Escudo Frailejón</span>
                    <div id="val-servo-angle" class="text-4xl font-extrabold text-purple-300 font-mono mt-2 tracking-tight">0<span class="text-lg text-slate-500 font-normal">°</span></div>
                    <div class="mt-2 flex items-center gap-2">
                        <span id="shield-badge" class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-purple-950/80 text-purple-300 border border-purple-800">100% Fotosíntesis</span>
                    </div>
                </div>
                <div class="relative w-20 h-20 flex items-center justify-center">
                    <svg class="w-20 h-20" viewBox="0 0 100 100">
                        <circle cx="50" cy="50" r="40" stroke="#1e293b" stroke-width="8" fill="transparent"/>
                        <circle id="gauge-servo-ring" class="gauge-circle" cx="50" cy="50" r="40" stroke="#b026ff" stroke-width="8" fill="transparent" stroke-dasharray="251.2" stroke-dashoffset="251.2" stroke-linecap="round"/>
                    </svg>
                    <span id="val-servo-pct" class="absolute text-xs font-mono font-bold text-purple-300">0%</span>
                </div>
            </div>

        </div>

        <!-- ================================================================= -->
        <!-- FILA CENTRAL: GEMELO DIGITAL + CONSOLA DE COMANDOS -->
        <!-- ================================================================= -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- Columna Izquierda (4 cols): GEMELO DIGITAL DEL BIORREACTOR -->
            <div class="lg:col-span-4 hud-card p-7 rounded-3xl flex flex-col justify-between border border-white/10 relative">
                <div>
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-xs font-mono font-bold uppercase tracking-widest text-teal-400 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-teal-400 animate-ping"></span>
                            Gemelo Digital (Vista en Corte)
                        </h3>
                        <span class="text-[11px] font-mono text-slate-400">Escala 1:1</span>
                    </div>
                    
                    <div class="relative w-full h-64 bg-black/60 rounded-2xl border border-white/5 flex items-center justify-center overflow-hidden my-3">
                        
                        <!-- Lámpara / Sol Radiante -->
                        <div class="absolute right-6 top-8 flex flex-col items-center">
                            <div class="text-4xl filter drop-shadow-[0_0_12px_#f59e0b]">☀️</div>
                            <span class="text-[9px] font-mono font-bold text-amber-300 mt-1 uppercase">Luz 4000 lux</span>
                            <div class="w-28 h-0.5 bg-gradient-to-l from-amber-400/50 to-transparent mt-1"></div>
                        </div>

                        <!-- Botella de Cultivo Cilíndrica -->
                        <div class="relative w-32 h-48 rounded-[36px] border-2 border-teal-400/50 bg-gradient-to-b from-teal-950/30 via-emerald-950/60 to-emerald-900/90 shadow-[0_0_40px_rgba(20,184,166,0.25)] flex flex-col justify-end p-3 overflow-hidden">
                            <!-- Nivel Líquido con Microalgas -->
                            <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-emerald-500/70 via-teal-600/40 to-transparent">
                                <div class="absolute bottom-2 left-6 w-2.5 h-2.5 rounded-full bg-teal-200/40 bubble-1"></div>
                                <div class="absolute bottom-6 right-8 w-2 h-2 rounded-full bg-emerald-200/50 bubble-2"></div>
                                <div class="absolute bottom-3 left-14 w-1.5 h-1.5 rounded-full bg-white/50 bubble-3"></div>
                            </div>

                            <!-- Termopozo con Sensor DS18B20 -->
                            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-2 h-36 bg-slate-300 rounded-b-full border border-slate-500 z-10">
                                <div class="w-3.5 h-4 bg-slate-800 rounded-full -ml-[3px] mt-32 border border-teal-400 shadow-[0_0_8px_#2dd4bf]"></div>
                            </div>

                            <div class="relative z-20 text-center pb-2">
                                <span class="text-[10px] font-mono text-slate-300 uppercase block font-bold tracking-wider">T. Cultivo</span>
                                <span id="twin-temp" class="text-xl font-black font-mono text-teal-200 drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)]">--.-°C</span>
                            </div>
                        </div>

                        <!-- Módulo Peltier y Placa de Cobre -->
                        <div class="absolute left-6 flex items-center">
                            <div class="w-3.5 h-28 bg-gradient-to-b from-amber-600 to-amber-700 rounded-l-md border border-amber-400 shadow-lg" title="Placa de Cobre Difusora"></div>
                            <div class="w-4 h-20 bg-slate-200 rounded-r border border-slate-400 shadow-md flex items-center justify-center" title="Celda Peltier TEC1-12706">
                                <span class="text-[7px] font-black text-slate-900 -rotate-90">PELTIER</span>
                            </div>
                        </div>

                        <!-- Escudo Orbital Rotatorio -->
                        <div id="twin-shield" class="absolute w-44 h-52 pointer-events-none transition-transform duration-500 ease-out flex items-center justify-end" style="transform: rotate(0deg);">
                            <div class="w-6 h-48 bg-white rounded-r-3xl border-2 border-slate-200 shadow-[0_0_25px_rgba(255,255,255,0.85)] flex flex-col justify-around items-center py-4">
                                <div class="w-1.5 h-6 bg-slate-300 rounded-full"></div>
                                <div class="w-1.5 h-12 bg-slate-300 rounded-full"></div>
                                <div class="w-1.5 h-6 bg-slate-300 rounded-full"></div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="bg-slate-950/80 p-4 rounded-2xl border border-white/5 space-y-2 text-xs">
                    <div class="flex justify-between items-center">
                        <span class="text-slate-400 font-mono">Ventana Biológica:</span>
                        <span class="text-emerald-400 font-mono font-bold">20.0°C &ndash; 22.5°C</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-400 font-mono">Umbral de Colapso:</span>
                        <span class="text-rose-400 font-mono font-bold">> 35.0°C (Lisis Celular)</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-400 font-mono">Albedo Frailejón:</span>
                        <span id="twin-albedo" class="text-purple-300 font-mono font-bold">0% (Luz Libre)</span>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha (8 cols): CONSOLA TÁCTICA -->
            <div class="lg:col-span-8 flex flex-col justify-between space-y-6">
                
                <!-- Barra de Modos de Operación -->
                <div class="hud-card p-6 rounded-3xl border border-white/10">
                    <div class="flex flex-wrap items-center justify-between gap-4 mb-5">
                        <div>
                            <span class="text-xs font-mono uppercase tracking-widest text-slate-400 font-semibold">Selector de Estrategia</span>
                            <h3 class="text-lg font-bold text-white font-sans mt-0.5">Control Térmico y Ensayos</h3>
                        </div>
                        <div class="flex items-center gap-3">
                            <button id="btn-start" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-mono font-bold rounded-xl shadow-lg transition flex items-center gap-2">
                                <span>▶</span> INICIAR GRABACIÓN
                            </button>
                            <button id="btn-stop" class="px-5 py-2.5 bg-rose-600 hover:bg-rose-500 text-white text-xs font-mono font-bold rounded-xl shadow-lg transition flex items-center gap-2">
                                <span>⏹</span> PARO TOTAL
                            </button>
                        </div>
                    </div>

                    <!-- Botón de Lazo Automático PI con Halo de Luz -->
                    <button id="btn-auto-pi" class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-teal-500/20 via-cyan-500/20 to-purple-500/20 hover:from-teal-500/30 hover:to-purple-500/30 border border-teal-400/40 text-white font-bold text-sm transition shadow-xl flex items-center justify-between group">
                        <div class="flex items-center gap-3">
                            <span class="text-2xl group-hover:scale-125 transition-transform">🧠</span>
                            <div class="text-left">
                                <span class="block text-sm font-bold text-teal-300">ACTIVAR CONTROL PI AUTOMÁTICO (CONSIGNA 21.0 °C)</span>
                                <span class="text-xs text-slate-400 font-normal font-sans">Ajuste continuo de Peltier + Despliegue automático del Escudo si T > 22°C</span>
                            </div>
                        </div>
                        <span id="auto-pi-badge" class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-slate-900 text-slate-400 border border-white/10">INACTIVO</span>
                    </button>
                </div>

                <!-- Dos Paneles de Calibración: Peltier y Servo -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                    <!-- Módulo A: Potencia Peltier / Escalones de Corriente -->
                    <div class="hud-card p-6 rounded-3xl border border-white/10 space-y-4">
                        <div class="flex justify-between items-center">
                            <span class="text-xs font-mono uppercase tracking-wider text-cyan-400 font-bold">⚡ Corriente Peltier (PWM)</span>
                            <span id="slider-pwm-display" class="text-xs font-mono font-bold text-white bg-slate-900 px-2.5 py-1 rounded-lg border border-white/10">0 / 255</span>
                        </div>
                        
                        <input type="range" id="slider-pwm" min="0" max="255" value="0" class="w-full cursor-pointer">

                        <div class="grid grid-cols-4 gap-2 pt-1">
                            <button class="btn-step py-2 rounded-xl text-xs font-mono font-bold bg-slate-900 hover:bg-cyan-950 text-cyan-300 border border-cyan-800/40 transition" data-pwm="64">25%</button>
