    <!-- MOTOR JAVASCRIPT: AUTOCONEXIÓN + ECHARTS + CONTROL -->
    <!-- ================================================================= -->
    <script is:inline>
        const API = 'http://127.0.0.1:5000';
        let isPolling = false;
        let isConnected = false;
        let autoScanInterval = null;
        let userManuallyDisconnected = false;

        // Toast de Notificación Flotante
        function showToast(title, msg, icon = "⚡") {
            const toast = document.getElementById('toast');
            document.getElementById('toast-title').textContent = title;
            document.getElementById('toast-msg').textContent = msg;
            document.getElementById('toast-icon').textContent = icon;
            toast.classList.remove('-translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('-translate-y-20', 'opacity-0');
            }, 3500);
        }

        // =================================================================
        // SISTEMA DE AUTODETECCIÓN Y CONEXIÓN INTELIGENTE DE LA ESP32
        // =================================================================
        async function autoDetectAndConnect() {
            if (isConnected || userManuallyDisconnected) return;
            try {
                const res = await fetch(`${API}/ports`);
                const ports = await res.json();
                
                // Buscar puerto USB estándar de ESP32 (ttyUSB*, ttyACM*, COM*)
                const espPort = ports.find(p => p.includes('ttyUSB') || p.includes('ttyACM') || p.startsWith('COM'));
                
                if (espPort) {
                    // Intentar conexión automática directa
                    const connRes = await fetch(`${API}/connect`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ port: espPort })
                    });
                    const connData = await connRes.json();
                    if (connData.status === 'success') {
                        setConnectedState(espPort);
                        showToast("ESP32 Autodetectada", `Enlace establecido en ${espPort}`, "🔌");
                        startSystem(); // Iniciar telemetría automáticamente
                    }
                }
            } catch (e) {
                // Backend no disponible aún
            }
        }

        function setConnectedState(port) {
            isConnected = true;
            document.getElementById('conn-dot').className = "w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_12px_#10b981]";
            document.getElementById('conn-text').textContent = "EN LÍNEA: " + port;
            document.getElementById('conn-text').className = "text-xs font-mono font-bold text-emerald-400";
            
            document.getElementById('btn-toggle-conn').classList.remove('hidden');
            document.getElementById('btn-manual-reconnect').classList.add('hidden');
        }

        async function disconnectSerial() {
            userManuallyDisconnected = true;
            try {
                await fetch(`${API}/disconnect`, { method: 'POST' });
            } catch(e) {}
            
            isConnected = false;
            isPolling = false;
            
            document.getElementById('conn-dot').className = "w-2.5 h-2.5 rounded-full bg-rose-500 shadow-[0_0_10px_#f43f5e]";
            document.getElementById('conn-text').textContent = "DESCONECTADO";
            document.getElementById('conn-text').className = "text-xs font-mono font-semibold text-slate-400";
            
            document.getElementById('btn-toggle-conn').classList.add('hidden');
            document.getElementById('btn-manual-reconnect').classList.remove('hidden');
            
            showToast("ESP32 Desconectada", "Puerto serial liberado", "🛑");
        }

        function manualReconnect() {
            userManuallyDisconnected = false;
            document.getElementById('conn-dot').className = "w-2.5 h-2.5 rounded-full bg-amber-400 shadow-[0_0_10px_#f59e0b] animate-pulse";
            document.getElementById('conn-text').textContent = "BUSCANDO ESP32...";
            document.getElementById('conn-text').className = "text-xs font-mono font-semibold text-slate-300";
            document.getElementById('btn-manual-reconnect').classList.add('hidden');
            autoDetectAndConnect();
        }

        // =================================================================
        // INICIALIZACIÓN DE APACHE ECHARTS
        // =================================================================
        let chartMain = null;
        let chartAct = null;
        try {
            const elMain = document.getElementById('echart-main');
            if (elMain) chartMain = echarts.init(elMain);
            const elAct = document.getElementById('echart-actuators');
            if (elAct) chartAct = echarts.init(elAct);
        } catch(e) {
            console.error("ECharts init error:", e);
        }

        const optionMain = {
            backgroundColor: 'transparent',
            tooltip: {
                trigger: 'axis',
                backgroundColor: 'rgba(9, 14, 26, 0.95)',
                borderColor: 'rgba(255, 255, 255, 0.1)',
                textStyle: { color: '#f8fafc', fontFamily: 'JetBrains Mono', fontSize: 11 },
                padding: [10, 14]
            },
            legend: {
                data: ['T. Reactor (Agua)', 'T. Ambiente (Disipador)', 'Consigna 21.0°C'],
                textStyle: { color: '#94a3b8', fontFamily: 'Space Grotesk' },
                top: 0, right: 10
            },
            grid: { left: '3%', right: '3%', bottom: '5%', top: '15%', containLabel: true },
            xAxis: {
                type: 'category',
                data: [],
                axisLine: { lineStyle: { color: 'rgba(255, 255, 255, 0.1)' } },
                axisLabel: { color: '#64748b', fontFamily: 'JetBrains Mono' },
                splitLine: { show: false }
            },
            yAxis: {
                type: 'value',
                axisLine: { lineStyle: { color: 'rgba(255, 255, 255, 0.1)' } },
                axisLabel: { color: '#64748b', fontFamily: 'JetBrains Mono', formatter: '{value} °C' },
                splitLine: { lineStyle: { color: 'rgba(255, 255, 255, 0.04)' } }
            },
            series: [
                {
                    name: 'T. Reactor (Agua)',
                    type: 'line',
                    smooth: true,
                    data: [],
                    symbol: 'circle',
                    symbolSize: 6,
                    itemStyle: { color: '#00f2fe' },
                    lineStyle: { width: 3, shadowColor: 'rgba(0, 242, 254, 0.4)', shadowBlur: 15 },
                    areaStyle: {
                        color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                            { offset: 0, color: 'rgba(0, 242, 254, 0.25)' },
                            { offset: 1, color: 'rgba(0, 242, 254, 0.0)' }
                        ])
                    }
                },
                {
                    name: 'T. Ambiente (Disipador)',
                    type: 'line',
                    smooth: true,
                    data: [],
                    itemStyle: { color: '#10b981' },
                    lineStyle: { width: 2, type: 'dashed' }
                },
                {
                    name: 'Consigna 21.0°C',
                    type: 'line',
                    data: [],
                    itemStyle: { color: '#f59e0b' },
                    lineStyle: { width: 2, type: 'dotted' }
                }
            ]
        };

        const optionAct = {
            backgroundColor: 'transparent',
            tooltip: {
                trigger: 'axis',
                backgroundColor: 'rgba(9, 14, 26, 0.95)',
                borderColor: 'rgba(255, 255, 255, 0.1)',
                textStyle: { color: '#f8fafc', fontFamily: 'JetBrains Mono', fontSize: 11 }
            },
            legend: {
                data: ['PWM Peltier', 'Ángulo Escudo'],
                textStyle: { color: '#94a3b8', fontFamily: 'Space Grotesk' },
                top: 0, right: 10
            },
            grid: { left: '3%', right: '3%', bottom: '5%', top: '15%', containLabel: true },
            xAxis: {
                type: 'category',
                data: [],
                axisLine: { lineStyle: { color: 'rgba(255, 255, 255, 0.1)' } },
                axisLabel: { color: '#64748b', fontFamily: 'JetBrains Mono' },
                splitLine: { show: false }
            },
            yAxis: [
                {
                    type: 'value',
                    name: 'PWM',
                    min: 0, max: 255,
                    axisLine: { lineStyle: { color: 'rgba(255, 255, 255, 0.1)' } },
                    axisLabel: { color: '#64748b', fontFamily: 'JetBrains Mono' },
                    splitLine: { lineStyle: { color: 'rgba(255, 255, 255, 0.04)' } }
                },
                {
                    type: 'value',
                    name: 'Ángulo',
                    min: 0, max: 180,
                    axisLine: { lineStyle: { color: 'rgba(255, 255, 255, 0.1)' } },
                    axisLabel: { color: '#64748b', fontFamily: 'JetBrains Mono', formatter: '{value}°' },
                    splitLine: { show: false }
                }
            ],
            series: [
                {
                    name: 'PWM Peltier',
                    type: 'line',
                    smooth: true,
                    data: [],
                    itemStyle: { color: '#06b6d4' },
                    lineStyle: { width: 2.5 }
                },
                {
                    name: 'Ángulo Escudo',
                    type: 'line',
                    yAxisIndex: 1,
                    smooth: true,
                    data: [],
                    itemStyle: { color: '#b026ff' },
                    lineStyle: { width: 2, type: 'dashed' }
                }
            ]
        };

        try {
            if (chartMain) chartMain.setOption(optionMain);
            if (chartAct) chartAct.setOption(optionAct);
        } catch(e) {
            console.error("ECharts setOption error:", e);
        }

        window.addEventListener('resize', () => {
            if (chartMain) chartMain.resize();
            if (chartAct) chartAct.resize();
            if (chartSensors) chartSensors.resize();
        });

        // =================================================================
        // FUNCIONES DE CONTROL
        // =================================================================
        async function startSystem() {
            const res = await fetch(`${API}/start`, { method: 'POST' });
            const data = await res.json();
            if (data.status === 'error') return showToast("Error", data.message, "⚠️");
            isPolling = true;
            pollTelemetry();
        }

        async function stopSystem() {
            await fetch(`${API}/stop`, { method: 'POST' });
            isPolling = false;
            updatePwmUI(0);
            updateServoUI(0);
            document.getElementById('auto-pi-badge').textContent = "INACTIVO";
            document.getElementById('auto-pi-badge').className = "px-3 py-1 rounded-full text-xs font-mono font-bold bg-slate-900 text-slate-400 border border-white/10";
            showToast("Paro Total Seguro", "Peltier apagado y escudo en 0°", "🛑");
        }

        async function setPwm(val) {
            val = parseInt(val);
            updatePwmUI(val);
            await fetch(`${API}/set_pwm`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ pwm: val })
            });
        }

        function updatePwmUI(val) {
            document.getElementById('slider-pwm').value = val;
            const pct = Math.round((val / 255) * 100);
            document.getElementById('slider-pwm-display').textContent = `${val} / 255 (${pct}%)`;
            document.getElementById('val-pwm-num').innerHTML = `${val}<span class="text-lg text-slate-500 font-normal">/255</span>`;
            document.getElementById('val-pwm-pct').textContent = `${pct}%`;
            
            const amps = ((val / 255) * 4.5).toFixed(1);
            const watts = Math.round((val / 255) * 4.5 * 12);
            document.getElementById('val-watts').textContent = `${watts} W`;
            document.getElementById('val-amps').textContent = `${amps} A`;

            const offset = 251.2 - (pct / 100) * 251.2;
            document.getElementById('gauge-pwm-ring').style.strokeDashoffset = offset;
        }

        async function setServo(angle) {
            angle = parseInt(angle);
            updateServoUI(angle);
            await fetch(`${API}/set_servo`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ angle })
            });
        }

        function updateServoUI(angle) {
            document.getElementById('slider-servo').value = angle;
            const pct = Math.round((angle / 180) * 100);
            document.getElementById('slider-servo-display').textContent = `${angle}° (${pct}%)`;
            document.getElementById('val-servo-angle').innerHTML = `${angle}<span class="text-lg text-slate-500 font-normal">°</span>`;
            document.getElementById('val-servo-pct').textContent = `${pct}%`;

            const offset = 251.2 - (pct / 100) * 251.2;
            document.getElementById('gauge-servo-ring').style.strokeDashoffset = offset;

            document.getElementById('twin-shield').style.transform = `rotate(${angle}deg)`;
            document.getElementById('twin-albedo').textContent = `${pct}% Albedo (${angle > 90 ? 'Sombra' : 'Luz'})`;

            const badge = document.getElementById('shield-badge');
            if (angle <= 20) {
                badge.className = "px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-950 text-emerald-300 border border-emerald-800";
                badge.textContent = "100% Fotosíntesis";
            } else if (angle >= 160) {
                badge.className = "px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-purple-950 text-purple-300 border border-purple-800";
                badge.textContent = "100% Albedo Frailejón";
            } else {
                badge.className = "px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-amber-950 text-amber-300 border border-amber-800";
                badge.textContent = `Despliegue ${pct}%`;
            }
        }

        async function toggleAutoPI() {
            const res = await fetch(`${API}/config_pi`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ mode: "pi_auto", setpoint: 21.0 })
            });
            const data = await res.json();
            if (data.status === 'success') {
                const badge = document.getElementById('auto-pi-badge');
                badge.textContent = "ACTIVO EN 21.0°C";
                badge.className = "px-3 py-1 rounded-full text-xs font-mono font-bold bg-teal-500 text-slate-950 shadow-[0_0_12px_#00f2fe]";
                showToast("Lazo PI Enganchado", "Controlando Peltier y Escudo hacia 21.0°C", "🧠");
                if (!isPolling) startSystem();
            }
        }

        async function runCohenCoon() {
            const res = await fetch(`${API}/calculate`);
            const data = await res.json();
            if (data.status === 'success') {
                showToast("Sintonización Exitosa", `Kp: ${data.Kp} | Ki: ${data.Ki}`, "📐");
            } else {
                showToast("Aviso FOPDT", data.message, "⚠️");
            }
        }

        async function pollTelemetry() {
            if (!isPolling) return;
            try {
                const res = await fetch(`${API}/data`);
                const payload = await res.json();
                const t = payload.telemetry;
                const c = payload.control;

                const lastT1 = (t.time && t.time.length > 0) ? t.temp1[t.temp1.length - 1] : (payload.latest ? payload.latest.temp1 : null);
                const lastT2 = (t.time && t.time.length > 0) ? t.temp2[t.temp2.length - 1] : (payload.latest ? payload.latest.temp2 : null);
                const lastPwm = (t.time && t.time.length > 0) ? t.pwm[t.pwm.length - 1] : (payload.latest ? payload.latest.pwm : 0);
                const lastServo = (t.time && t.time.length > 0) ? t.servo_angle[t.servo_angle.length - 1] : (payload.latest ? payload.latest.servo_angle : 0);

                if (lastT1 !== null && lastT1 !== undefined) {
                    if (lastT1 <= -100) {
                        document.getElementById('val-t1').innerHTML = `-127<span class="text-lg text-rose-500 font-normal">°C</span>`;
                        document.getElementById('twin-temp').textContent = `-127°C`;
                    } else {
                        document.getElementById('val-t1').innerHTML = `${lastT1.toFixed(1)}<span class="text-lg text-slate-500 font-normal">°C</span>`;
                        document.getElementById('twin-temp').textContent = `${lastT1.toFixed(1)}°C`;
                    }

                    const pctT1 = lastT1 <= -100 ? 0 : Math.max(0, Math.min(100, ((lastT1 - 15) / 20) * 100));
                    document.getElementById('gauge-t1-ring').style.strokeDashoffset = 251.2 - (pctT1 / 100) * 251.2;

                    const badge = document.getElementById('badge-optimo');
                    if (lastT1 <= -100) {
                        badge.className = "px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-rose-950 text-rose-300 border border-rose-700 animate-pulse";
                        badge.textContent = "Error: Bus 15 Caído";
                    } else if (lastT1 >= 20.0 && lastT1 <= 22.5) {
                        badge.className = "px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-950 text-emerald-300 border border-emerald-700";
                        badge.textContent = "Óptimo T. chuii";
                    } else if (lastT1 > 22.5 && lastT1 <= 25.0) {
                        badge.className = "px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-amber-950 text-amber-300 border border-amber-700";
                        badge.textContent = "Alerta Térmica";
                    } else if (lastT1 > 25.0) {
                        badge.className = "px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-rose-950 text-rose-300 border border-rose-700";
                        badge.textContent = "Estrés Crítico";
                    } else {
                        badge.className = "px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-blue-950 text-blue-300 border border-blue-700";
                        badge.textContent = "Subóptimo Frío";
                    }
                }

                if (lastT2 !== null && lastT2 !== undefined) {
                    if (lastT2 <= -100) {
                        document.getElementById('val-t2').innerHTML = `-127<span class="text-lg text-rose-500 font-normal">°C</span>`;
                    } else {
                        document.getElementById('val-t2').innerHTML = `${lastT2.toFixed(1)}<span class="text-lg text-slate-500 font-normal">°C</span>`;
                    }
                    const pctT2 = lastT2 <= -100 ? 0 : Math.max(0, Math.min(100, ((lastT2 - 15) / 20) * 100));
                    document.getElementById('gauge-t2-ring').style.strokeDashoffset = 251.2 - (pctT2 / 100) * 251.2;
                }

                const lastHum = latest ? latest.humidity : null;

                if (lastT1 !== null || lastT2 !== null) {
                    updateSensorDiagnostics(lastT1, lastT2, lastHum);
                }

                if (t.time && t.time.length > 0) {
                    if (c && c.mode === "pi_auto") {
                        updatePwmUI(lastPwm);
                        updateServoUI(lastServo);
                    }

                    const timeLabels = t.time.map(s => Math.round(s) + 's');
                    const setpointLine = t.time.map(() => 21.0);

                    if (chartMain) {
                        chartMain.setOption({
                            xAxis: { data: timeLabels },
                            series: [
                                { name: 'T. Reactor (Agua)', data: t.temp1 },
                                { name: 'T. Ambiente (Disipador)', data: t.temp2 },
                                { name: 'Consigna 21.0°C', data: setpointLine }
                            ]
                        });
                    }

                    if (chartAct) {
                        chartAct.setOption({
                            xAxis: { data: timeLabels },
                            series: [
                                { name: 'PWM Peltier', data: t.pwm },
                                { name: 'Ángulo Escudo', data: t.servo_angle }
                            ]
                        });
                    }

                    // Actualizar métricas del Banco de Diagnóstico de Sensores
                    updateSensorDiagnostics(lastT1, lastT2);

                    if (chartSensors) {
                        chartSensors.setOption({
                            xAxis: { data: timeLabels },
                            series: [
                                { name: 'Sensor 1: Agua (D15)', data: t.temp1 },
                                { name: 'Sensor 2: Ambiente (D13)', data: t.temp2 }
                            ]
                        });
                    }
                }
            } catch (e) {
                // Si falla la lectura, verificar si la ESP32 se desconectó
                checkDeviceLive();
            }
            setTimeout(pollTelemetry, 1000);
        }

